# ── Hub Central MbeukTechnologies — variables SERVEUR uniquement ──
# Ne JAMAIS préfixer ces variables par NEXT_PUBLIC_ / VITE_ : elles ne
# doivent JAMAIS être lues depuis le navigateur. Seules les fonctions
# serverless dans /api/hub/*.js les lisent, via process.env côté Vercel.
#
# Renseignez les VRAIES valeurs UNIQUEMENT dans :
#   - Vercel → Project → Settings → Environment Variables (prod/preview/dev)
#   - .env.local en développement local (jamais commité — déjà dans .gitignore)
#
# Ne collez JAMAIS une vraie clé mbs_... dans un chat IA, un ticket, ou un
# message Slack/WhatsApp.

# URL du Hub Central (sans slash final), ex: https://hub.mbeuktech.com
MBEUK_HUB_URL=

# Clé API SaaS du Hub (mbs_...) — SECRET, scopes auth:* + licenses:verify
MBEUK_HUB_API_KEY=

# UUID du produit "MbeukChurch" dans le Hub (Super Admin → Produits)
MBEUK_PRODUCT_ID=

# ── Optionnel : Brevo côté SaaS ──
# Uniquement si le Hub n'a PAS déjà HUB_BREVO_* configuré en interne pour
# l'envoi d'email "mot de passe oublié". Sinon laissez vide.
SAAS_BREVO_API_KEY=
SAAS_BREVO_SENDER_EMAIL=
SAAS_BREVO_SENDER_NAME=

# ── Optionnel : liste blanche d'origine (défense anti-CSRF/confused-deputy) ──
# URL complète de votre domaine de production, ex: https://mbeukchurch.com
# Les déploiements Vercel preview sont couverts automatiquement (VERCEL_URL).
ALLOWED_ORIGIN=
